# Transit Pulse Environment Variables
# Masukkan CARTO API Key (Server-Side Secret):
CARTO_API_KEY=

# Webhook Discord untuk Masukan Pengguna (Server-Side Secret, opsional):
FEEDBACK_WEBHOOK_URL=

# Cloudflare Turnstile Anti-Bot Protection (Testing keys default: Always Passes)
# Ganti dengan Site Key dan Secret Key riil dari https://dash.cloudflare.com/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
